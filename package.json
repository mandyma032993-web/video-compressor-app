{
  "name": "video-compressor",
  "version": "1.0.0",
  "description": "Video Compressor desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-mac": "electron-builder --mac",
    "build-win": "electron-builder --win"
  },
  "build": {
    "appId": "com.videocompressor.app",
    "productName": "Video Compressor",
    "extraResources": [
      { "from": "server.py", "to": "server.py" },
      { "from": "node_modules/ffmpeg-static/ffmpeg", "to": "bin/ffmpeg" },
      { "from": "node_modules/ffprobe-static/bin/darwin/arm64/ffprobe", "to": "bin/ffprobe" }
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "assets/icon.icns"
    },
    "win": {
      "icon": "assets/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  }
}
