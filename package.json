{
  "name": "video-compressor",
  "version": "1.0.0",
  "description": "Video Compressor desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:server": "/Users/tal/Library/Python/3.9/bin/pyinstaller --onefile --name server --add-data 'index.html:.' --add-data 'app.js:.' server.py",
    "build-mac": "npm run build:server && electron-builder --mac",
    "build-win": "npm run build:server && electron-builder --win"
  },
  "build": {
    "appId": "com.videocompressor.app",
    "productName": "Video Compressor",
    "asar": true,
    "beforePack": "./beforePack.js",
    "extraResources": [
      { "from": "dist/server", "to": "server" },
      { "from": "node_modules/ffmpeg-static/ffmpeg", "to": "bin/ffmpeg" },
      { "from": "node_modules/ffprobe-static/bin/darwin/x64/ffprobe", "to": "bin/ffprobe" }
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "assets/icon.icns",
      "x64ArchFiles": "Contents/Resources/bin/ffprobe"
    },
    "win": {
      "icon": "assets/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  }
}
